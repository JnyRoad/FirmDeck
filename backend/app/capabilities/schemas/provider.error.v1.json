{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firmdeck.dev/contracts/provider/error/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["error_code", "message", "retryable", "request_id"],
  "properties": {
    "error_code": {"type": "string", "minLength": 1},
    "message": {"type": "string", "minLength": 1, "deprecated": true},
    "retryable": {"type": "boolean"},
    "request_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": ["string", "null"], "minLength": 1},
    "params": {"type": "object"},
    "provider_id": {"type": ["string", "null"]},
    "deprecated_fields": {
      "type": "array",
      "items": {"enum": ["message"]},
      "uniqueItems": true
    },
    "extensions": {
      "type": "object",
      "patternProperties": {"^(?!core$|firmdeck$)[a-z][a-z0-9_]*$": {"type": "object"}},
      "additionalProperties": false
    }
  }
}
